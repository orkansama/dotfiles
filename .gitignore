#Ignore all Files
*

#Unignore all Subfiles
!*/

#Unignore all scripts
!*.sh

#Unignore Hyprland config
!hypr/
!hypr/**

#Unignore Wofi config
!rofi/
!rofi/**

#Unignore zsh config
zsh/*
!zsh/.zshenv
!zsh/.zshrc

#Unignore alacritty config
!alacritty/*

#Unignore waybar config
!waybar/*/*

#Unignore yazi config
!yazi/*

#Unignore tmux config
!tmux/**
tmux/plugins

#Unignore lazygit config
!lazygit/*

#Unignore delta config
!delta/*

#Unignore .gitconfig config
!.gitconfig
